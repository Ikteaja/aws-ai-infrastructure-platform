{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDevEksCluster",
      "Effect": "Allow",
      "Action": [
        "eks:CreateCluster",
        "eks:DeleteCluster",
        "eks:DescribeCluster",
        "eks:DescribeUpdate",
        "eks:UpdateClusterConfig",
        "eks:UpdateClusterVersion",
        "eks:TagResource",
        "eks:UntagResource"
      ],
      "Resource": "arn:aws:eks:eu-central-1:429496640190:cluster/ai-platform-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ManageDevCpuNodegroup",
      "Effect": "Allow",
      "Action": [
        "eks:CreateNodegroup",
        "eks:DeleteNodegroup",
        "eks:DescribeNodegroup",
        "eks:DescribeUpdate",
        "eks:UpdateNodegroupConfig",
        "eks:UpdateNodegroupVersion",
        "eks:TagResource",
        "eks:UntagResource"
      ],
      "Resource": [
        "arn:aws:eks:eu-central-1:429496640190:cluster/ai-platform-dev",
        "arn:aws:eks:eu-central-1:429496640190:nodegroup/ai-platform-dev/ai-platform-dev-cpu/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ManageDevEksAddons",
      "Effect": "Allow",
      "Action": [
        "eks:CreateAddon",
        "eks:DeleteAddon",
        "eks:DescribeAddon",
        "eks:UpdateAddon",
        "eks:TagResource",
        "eks:UntagResource"
      ],
      "Resource": [
        "arn:aws:eks:eu-central-1:429496640190:cluster/ai-platform-dev",
        "arn:aws:eks:eu-central-1:429496640190:addon/ai-platform-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ManageDevEksPodIdentityAssociation",
      "Effect": "Allow",
      "Action": [
        "eks:CreatePodIdentityAssociation",
        "eks:DeletePodIdentityAssociation",
        "eks:DescribePodIdentityAssociation",
        "eks:TagResource",
        "eks:UntagResource"
      ],
      "Resource": [
        "arn:aws:eks:eu-central-1:429496640190:cluster/ai-platform-dev",
        "arn:aws:eks:eu-central-1:429496640190:podidentityassociation/ai-platform-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ListDevEksPodIdentityAssociations",
      "Effect": "Allow",
      "Action": "eks:ListPodIdentityAssociations",
      "Resource": "arn:aws:eks:eu-central-1:429496640190:cluster/ai-platform-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ManageDevAdministratorAccessEntry",
      "Effect": "Allow",
      "Action": [
        "eks:CreateAccessEntry",
        "eks:DeleteAccessEntry",
        "eks:DescribeAccessEntry",
        "eks:AssociateAccessPolicy",
        "eks:DisassociateAccessPolicy",
        "eks:ListAssociatedAccessPolicies"
      ],
      "Resource": [
        "arn:aws:eks:eu-central-1:429496640190:cluster/ai-platform-dev",
        "arn:aws:eks:eu-central-1:429496640190:access-entry/ai-platform-dev/*",
        "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "DiscoverCompatibleEksVersions",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeAddonVersions",
        "eks:ListClusters"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "PassOnlyEksServiceRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::429496640190:role/healthops-dev-eks-cluster",
        "arn:aws:iam::429496640190:role/healthops-dev-eks-workers",
        "arn:aws:iam::429496640190:role/healthops-dev-eks-vpc-cni"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "eks.amazonaws.com",
            "ec2.amazonaws.com",
            "pods.eks.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadDevEksVpcCniRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::429496640190:role/healthops-dev-eks-vpc-cni"
    },
    {
      "Sid": "CreateNamedDevLaunchTemplate",
      "Effect": "Allow",
      "Action": "ec2:CreateLaunchTemplate",
      "Resource": "arn:aws:ec2:eu-central-1:429496640190:launch-template/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:RequestTag/Name": "ai-platform-dev-cpu",
          "aws:RequestTag/Project": "healthcare-operations-assistant",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "UpdateOrDeleteNamedDevLaunchTemplate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate",
        "ec2:DeleteLaunchTemplate"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:429496640190:launch-template/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "aws:ResourceTag/Name": "ai-platform-dev-cpu"
        }
      }
    },
    {
      "Sid": "TagNamedDevLaunchTemplateOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:eu-central-1:429496640190:launch-template/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "ec2:CreateAction": "CreateLaunchTemplate",
          "aws:RequestTag/Name": "ai-platform-dev-cpu",
          "aws:RequestTag/Project": "healthcare-operations-assistant",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "ReadLaunchTemplateInventory",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ManageEksControlPlaneLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:eu-central-1:429496640190:log-group:/aws/eks/ai-platform-dev/cluster",
        "arn:aws:logs:eu-central-1:429496640190:log-group:/aws/eks/ai-platform-dev/cluster:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "CreateEksServiceLinkedRoleIfMissing",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "eks.amazonaws.com"
        }
      }
    }
  ]
}
