{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchDevEksCpuInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "ec2:LaunchTemplate": "arn:aws:ec2:eu-central-1:429496640190:launch-template/lt-0d2dcb9b40ef159b8",
          "ec2:InstanceType": "t3.medium",
          "ec2:InstanceMarketType": "on-demand",
          "ec2:MetadataHttpTokens": "required"
        },
        "NumericEquals": {
          "ec2:MetadataHttpPutResponseHopLimit": 1
        }
      }
    },
    {
      "Sid": "UseNamedDevEksCpuLaunchTemplate",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:eu-central-1:429496640190:launch-template/lt-0d2dcb9b40ef159b8",
      "Condition": {
        "StringEquals": {
          "ec2:LaunchTemplate": "arn:aws:ec2:eu-central-1:429496640190:launch-template/lt-0d2dcb9b40ef159b8",
          "aws:ResourceTag/Name": "ai-platform-dev-cpu",
          "aws:ResourceTag/Project": "healthcare-operations-assistant",
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "CreateDevEksCpuNetworkInterfaces",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:eu-central-1:429496640190:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "ec2:Vpc": "arn:aws:ec2:eu-central-1:429496640190:vpc/vpc-0213b3c62cb94e86d",
          "ec2:Subnet": [
            "arn:aws:ec2:eu-central-1:429496640190:subnet/subnet-0a520b845174e472e",
            "arn:aws:ec2:eu-central-1:429496640190:subnet/subnet-097a6504a725de799"
          ],
          "ec2:LaunchTemplate": "arn:aws:ec2:eu-central-1:429496640190:launch-template/lt-0d2dcb9b40ef159b8"
        },
        "Bool": {
          "ec2:AssociatePublicIpAddress": false
        }
      }
    },
    {
      "Sid": "TagDevEksCpuInstancesAndVolumesOnLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:eu-central-1:429496640190:instance/*",
        "arn:aws:ec2:eu-central-1:429496640190:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "ec2:CreateAction": "RunInstances",
          "aws:RequestTag/Name": "ai-platform-dev-cpu-worker",
          "aws:RequestTag/Project": "healthcare-operations-assistant",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Component": "eks",
          "aws:RequestTag/Owner": "Ikteaja"
        }
      }
    }
  ]
}
